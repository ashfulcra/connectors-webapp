# Auth0 Configuration
PUBLIC_AUTH0_DOMAIN="fulcra.us.auth0.com"
PUBLIC_AUTH0_CLIENT_ID="whF3ymxsYHijh2QrGkGbgDkxqDDAA8KB"

# Fulcra API Endpoint (used for Auth0 audience and server-side API calls)
PUBLIC_FULCRA_API_ENDPOINT="https://api.fulcradynamics.com/"
# For local development, use:
# PUBLIC_FULCRA_API_ENDPOINT="http://localhost:8008/"

# Server-only deployment values; set from your own harness bootstrap state.
OWNER_USER_ID=""
HARNESS_DATA_TYPE=""
WORKSPACE_PATH="workspace/connectors-webapp"
CONNECTORS_DEPLOYMENT_ID=""
DATABASE_URL=""
CREDENTIAL_ENCRYPTION_KEY=""
CREDENTIAL_KEY_ID="v1"
CRON_SECRET=""

# Optional JSON object mapping previous key IDs to base64 keys during rotation.
CREDENTIAL_PREVIOUS_KEYS={}

# Personal deployments are private by default. Only the shared template opts in.
CONNECTORS_MODE="personal"

# Fulcra-hosted clones use native durable Workflow state and polling.
CONNECTORS_BACKEND="workflow"
CONNECTORS_NATIVE_ROOT_RUN_ID=""
CONNECTORS_NATIVE_ALLOW_BOOTSTRAP="1"
CONNECTORS_NATIVE_BOOTSTRAP_SECRET=""
